#!/usr/bin/env bash
# Concern: the mechanical gates — a flat list of commands, each blocking on its own exit status | Non-concern: the review attestation, which this repo does not self-gate | IO: (staged tree) -> exit status
# No commit-msg gate: gating this tool with this tool is circular; reviews run by hand instead.
# Linter versions are pinned at install time (README), not here, to avoid a second file for one caller.
set -euo pipefail

cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
case ":$PATH:" in *":$cargo_bin:"*) ;; *) PATH="$cargo_bin:$PATH" ;; esac
export PATH

cargo fmt --all -- --check
# --locked: else a stale Cargo.lock is rewritten here and the mismatch only surfaces at `cargo publish`.
cargo clippy --workspace --all-targets --locked -- -D warnings
cargo test --workspace --locked --quiet
annotated-tree --strict-check --include-tests .
comment-crusher .
